@startuml UC03_EditProfile
' UC-03: Edit Profile (enter edit mode, client-side validation)
skinparam shadowing false
skinparam packageStyle rectangle
skinparam DefaultFontName Arial
left to right direction

package "Entities Circle" as EC {
  class User
}

package "Use Case Circle" as UC {
  interface InputBoundary
  interface OutputBoundary
  class ProfileService {
    +execute(req: EditProfileRequestModel): EditProfileResponseModel
  }
  class EditProfileRequestModel
  class EditProfileResponseModel
  note right of ProfileService
    Interactor mainly validates intent
    and may preload current data
  end note

  InputBoundary <|.. ProfileService
  ProfileService ..|> OutputBoundary
}

package "Interface Adapters" as IA {
  class ProfileController { +editProfile() }
  class ProfilePresenter { +present(res: EditProfileResponseModel) }
  class EditProfileVM as ViewModel
}

package "Frameworks & Drivers" as FD {
  class "Spring Boot MVC" as Spring
  class "DB (Postgres/H2)\nJPA/Hibernate" as DB
  class "HTTP/JSON Client (Frontend)"
}

ProfileController --> InputBoundary : execute(EditProfileRequestModel)
ProfileService --> OutputBoundary : present(EditProfileResponseModel)
OutputBoundary <.. ProfilePresenter
ProfilePresenter --> ViewModel
ProfileController <-- ViewModel : HTTP JSON (form model)

@enduml