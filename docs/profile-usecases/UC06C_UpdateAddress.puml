@startuml UC06C_UpdateAddress
' UC-06C: Update Address
skinparam shadowing false
skinparam packageStyle rectangle
skinparam DefaultFontName Arial
left to right direction

package "Entities Circle" as EC {
  class Address
}

package "Use Case Circle" as UC {
  interface InputBoundary
  interface OutputBoundary
  class ProfileService {
    +execute(req: UpdateAddressRequest): AddressDTO
  }
  class UpdateAddressRequest
  class AddressDTO

  InputBoundary <|.. ProfileService
  ProfileService ..|> OutputBoundary
}

package "Interface Adapters" as IA {
  class ProfileController { +updateAddress(id, body) }
  class AddressPresenter { +present(res: AddressDTO) }
  class AddressDTO
}

package "Frameworks & Drivers" as FD {
  class "Spring Boot MVC" as Spring
  class "DB (Postgres/H2)\nJPA/Hibernate" as DB
}

ProfileController --> InputBoundary : execute(UpdateAddressRequest)
ProfileService --> AddressRepository : verify ownership
ProfileService --> AddressRepository : update fields; if isDefault -> clear others
ProfileService --> OutputBoundary : present(AddressDTO)
OutputBoundary <.. AddressPresenter
AddressPresenter --> AddressDTO
ProfileController <-- AddressDTO : HTTP JSON

@enduml