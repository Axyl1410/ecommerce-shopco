@startuml UC06D_DeleteAddress
' UC-06D: Delete Address
skinparam shadowing false
skinparam packageStyle rectangle
skinparam DefaultFontName Arial
left to right direction

rectangle "Entities Circle" as EC {
  class Address
}

rectangle "Use Case Circle" as UC {
  interface InputBoundary <<interface>>
  interface OutputBoundary <<interface>>
  class ProfileService as Interactor {
    +execute(req: DeleteAddressRequest): DeleteResultDTO
  }
  class DeleteAddressRequest
  class DeleteResultDTO

  InputBoundary <|.. Interactor
  Interactor ..|> OutputBoundary
}

rectangle "Interface Adapters" as IA {
  class ProfileController { +deleteAddress(id) }
  class AddressPresenter { +present(res: DeleteResultDTO) }
  class DeleteResultDTO
}

rectangle "Frameworks & Drivers" as FD {
  node "Spring Boot MVC" as Spring
  database "DB (Postgres/H2)\nJPA/Hibernate" as DB
}

ProfileController --> InputBoundary : execute(DeleteAddressRequest)
Interactor --> AddressRepository : verify ownership; delete address
Interactor --> OutputBoundary : present(DeleteResultDTO)
OutputBoundary <.. AddressPresenter
AddressPresenter --> DeleteResultDTO
ProfileController <-- DeleteResultDTO : HTTP JSON

@enduml