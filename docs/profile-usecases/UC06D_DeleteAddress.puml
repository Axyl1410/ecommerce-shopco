@startuml UC06D_DeleteAddress
' UC-06D: Delete Address
skinparam shadowing false
skinparam packageStyle rectangle
skinparam DefaultFontName Arial
left to right direction

package "Entities Circle" as EC {
  class Address
}

package "Use Case Circle" as UC {
  interface InputBoundary
  interface OutputBoundary
  class ProfileService {
    +execute(req: DeleteAddressRequest): DeleteResultDTO
  }
  class DeleteAddressRequest
  class DeleteResultDTO

  InputBoundary <|.. ProfileService
  ProfileService ..|> OutputBoundary
}

package "Interface Adapters" as IA {
  class ProfileController { +deleteAddress(id) }
  class AddressPresenter { +present(res: DeleteResultDTO) }
  class DeleteResultDTO
}

package "Frameworks & Drivers" as FD {
  class "Spring Boot MVC" as Spring
  class "DB (Postgres/H2)\nJPA/Hibernate" as DB
}

ProfileController --> InputBoundary : execute(DeleteAddressRequest)
ProfileService --> AddressRepository : verify ownership; delete address
ProfileService --> OutputBoundary : present(DeleteResultDTO)
OutputBoundary <.. AddressPresenter
AddressPresenter --> DeleteResultDTO
ProfileController <-- DeleteResultDTO : HTTP JSON

@enduml